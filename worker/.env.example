# worker/.env.example
# Copy to worker/.env (gitignored) and fill in APMS_DEVICE_TOKEN.
# Run the worker with:
#   APMS_ENV_FILE=worker/.env ./scripts/with_env.sh \
#       ~/venvs/worker/bin/python -m worker.main

APMS_SERVER_URL=http://127.0.0.1:8000

# Printed once by `manage.py create_camera`, or by POST /lots/{id}/cameras.
# Lost it? Rotate with POST /api/v1/cameras/{id}/token:rotate as an OWNER.
APMS_DEVICE_TOKEN=

# Model cache and the SQLite outbox. The Dockerfile overrides this to /data.
APMS_DATA_DIR=./worker-data

APMS_LOG_LEVEL=INFO
APMS_HTTP_TIMEOUT=10

# The ms/slot figure in RESULTS.md was measured single-threaded. Raising this
# makes the deployment faster than the number you published — note it if you do.
APMS_ORT_THREADS=1