// .vscode/settings.json
{
  "files.eol": "\n",
  "git.path": "/usr/bin/git",
  "python.defaultInterpreterPath": "${userHome}/venvs/server/bin/python",
  "files.watcherExclude": {
    "**/data/**": true,
    "**/models/**": true,
    "**/venvs/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/data/**": true,
    "**/models/**": true
  }
}