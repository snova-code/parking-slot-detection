# Copy to infra/.env and fill every blank. infra/.env is gitignored.
# Database password:  openssl rand -base64 32
POSTGRES_DB=apms
POSTGRES_USER=apms
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Django secret:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# false locally over http; true in deployment behind https
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=

# Worker config. The smoothing pair is a measured result — use the pair from
# ml/results/smoothing_sweep.md as a STARTING POINT; it was validated on
# 5-minute PKLot frames, not on 2 fps video. Deliberately no default.
APMS_SMOOTHING_WINDOW=
APMS_SMOOTHING_MIN_AGREEMENT=
APMS_TARGET_FPS=2
# Where workers download the ONNX model. {version} is substituted.
APMS_MODEL_URL_TEMPLATE=https://github.com/snova=code/apms/releases/download/{version}/{version}.onnx

# Redis is a bus, not a store: no persistence is configured and none is needed.
APMS_REDIS_URL=redis://127.0.0.1:6379/0

# Set true only when a proxy you control sets X-Forwarded-For; otherwise
# clients can claim any address and defeat IP rate limiting.
APMS_TRUST_X_FORWARDED_FOR=false

# worker/.env.example
# Copy to worker/.env (gitignored) and fill in.
#   APMS_ENV_FILE=worker/.env ./scripts/with_env.sh <command>
APMS_SERVER_URL=http://127.0.0.1:8000

# Model cache and the local event queue. The Dockerfile sets this to /data.
APMS_DATA_DIR=./worker-data
APMS_LOG_LEVEL=INFO
APMS_HTTP_TIMEOUT=10
# The published ms/slot figure is single-threaded; raising this makes the
# deployment faster than the number in RESULTS.md.
APMS_ORT_THREADS=1

# --- Containerised worker (docker compose --profile app) ---------------------
# Printed once by `manage.py create_camera` or POST /lots/{id}/cameras.
APMS_DEVICE_TOKEN=
# Directory mounted at /demo in the container. The camera's source_uri must
# then be file:///demo/<name>.mp4, not a host path.
APMS_DEMO_VIDEO_DIR=./demo