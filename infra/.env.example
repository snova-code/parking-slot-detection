# Copy to infra/.env and fill every blank. infra/.env is gitignored.
# Database password:  openssl rand -base64 32
POSTGRES_DB=apms
POSTGRES_USER=apms
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Django secret:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost